# Copy to .env and fill locally. Never commit .env.
# OPEN5G_SESSION_PEPPER must be at least 32 characters and unique per deployment.
OPEN5G_SESSION_PEPPER=
OPEN5G_DATABASE_URL=
OPEN5G_COOKIE_SECURE=1
OPEN5G_ENABLE_DEMO_ROUTES=0
# Optional one-shot admin bootstrap. The script refuses to run if this is empty.
OPEN5G_BOOTSTRAP_PASSWORD=
OPEN5G_BOOTSTRAP_EMAIL=
# Phase 1 subscriber store. Empty disables Mongo writes. No WebUI API is used.
# URI may include credentials and TLS query parameters. Placeholder only.
OPEN5G_MONGO_URI=
OPEN5G_MONGO_DATABASE=open5gs
OPEN5G_MONGO_COLLECTION=subscribers
OPEN5G_MONGO_TIMEOUT_MS=2000
# Live Gx RAR. Keep 0. Stock Open5GS 2.8 and the draft PCRF patch do not push an active session.
OPEN5G_ENABLE_GX_RAR=0
# name=url pairs. Empty means NF metrics/health are not configured (not a scrape error).
# OPEN5G_METRICS_ENDPOINTS=smf=http://REPLACE_HOST:9090/metrics,upf-a=http://REPLACE_HOST:9091/metrics,upf-b=http://REPLACE_HOST:9092/metrics
OPEN5G_METRICS_ENDPOINTS=
OPEN5G_HEALTH_ENDPOINTS=
OPEN5G_METRICS_TIMEOUT_S=2
# Comma-separated APNs that SMF/UPF may serve. Empty does not enforce a list.
OPEN5G_APN_ALLOWLIST=
# Comma-separated browser origins. Empty disables CORS. A wildcard is rejected.
OPEN5G_CORS_ORIGINS=
# Loopback is the local default. A container on an internal network sets 0.0.0.0 and does not publish the port.
OPEN5G_BIND_HOST=127.0.0.1
OPEN5G_BIND_PORT=8000
