# Copy to .env and fill locally. Never commit .env.
# OPEN5G_SESSION_PEPPER must be at least 32 characters and unique per deployment.
OPEN5G_SESSION_PEPPER=
OPEN5G_DATABASE_URL=
OPEN5G_COOKIE_SECURE=1
OPEN5G_ENABLE_DEMO_ROUTES=0
# Optional one-shot admin bootstrap. The script refuses to run if this is empty.
OPEN5G_BOOTSTRAP_PASSWORD=
OPEN5G_BOOTSTRAP_EMAIL=
