+function open5gLimit(name: string, fallback: number): number {
+    if (typeof window === 'undefined') {
+        return fallback;
+    }
+    const box = window as unknown as { __OPEN5G_LIMITS?: Record<string, unknown> };
+    const raw = box.__OPEN5G_LIMITS ? box.__OPEN5G_LIMITS[name] : undefined;
+    const value = typeof raw === 'number' ? raw : Number(raw);
+    if (!Number.isFinite(value) || value <= 0) {
+        return fallback;
+    }
+    return value;
+}
