diff -ruN a/scripts/start-emulator.sh b/scripts/start-emulator.sh
--- a/scripts/start-emulator.sh	2026-11-11 11:05:15.309452166 +0000
+++ b/scripts/start-emulator.sh	2026-11-11 11:06:55.416406178 +0000
@@ -12,15 +12,19 @@
 OPT_CORES=${CORES:-4}
 OPT_SKIP_AUTH=${SKIP_AUTH:-true}
 AUTH_FLAG=
-# Start ADB server by listening on all interfaces.
+# Open5G: loopback only. -a would listen on every interface.
 echo "Starting the ADB server ..."
-adb -a -P 5037 server nodaemon &
+adb -P 5037 server nodaemon &
 
-# Detect ip and forward ADB ports from the container's network
-# interface to localhost.
-LOCAL_IP=$(ip addr list eth0 | grep "inet " | cut -d' ' -f6 | cut -d/ -f1)
-socat tcp-listen:"$EMULATOR_CONSOLE_PORT",bind="$LOCAL_IP",fork tcp:127.0.0.1:"$EMULATOR_CONSOLE_PORT" &
-socat tcp-listen:"$ADB_PORT",bind="$LOCAL_IP",fork tcp:127.0.0.1:"$ADB_PORT" &
+# Open5G: bind socat to the uu address. eth0 is not stable with a second network.
+case "${ANDROID_UE_UU:-}" in
+  ""|0.0.0.0|eth0|127.*|0.*)
+    echo "start-emulator: refusing socat bind ${ANDROID_UE_UU:-empty}" >&2
+    exit 1
+    ;;
+esac
+socat tcp-listen:"$EMULATOR_CONSOLE_PORT",bind="${ANDROID_UE_UU}",fork,reuseaddr tcp:127.0.0.1:"$EMULATOR_CONSOLE_PORT" &
+socat tcp-listen:"$ADB_PORT",bind="${ANDROID_UE_UU}",fork,reuseaddr tcp:127.0.0.1:"$ADB_PORT" &
 
 export USER=root
 
