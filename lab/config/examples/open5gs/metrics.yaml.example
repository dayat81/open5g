# Example only. Not rendered by Ansible and not mounted into the lab containers.
# Enabling this is a separate lab change and needs owner approval.
# Upstream Open5GS metrics tutorial (read 2026-11-10) documents export for AMF, MME, and SMF.
# This EPC lab has no AMF. HSS, PCRF, SGW-C/U, and UPF are not claimed here.
# Bind on the NF address that shares a Docker network with the scraper.
# 127.0.0.1 is only reachable inside that same container, so it is not used here.
# Do not publish the port on the host until that exposure is reviewed.
mme:
  metrics:
    server:
      - address: REPLACE_WITH_CONTAINER_NETWORK_ADDRESS
        port: 9090
smf:
  metrics:
    server:
      - address: REPLACE_WITH_CONTAINER_NETWORK_ADDRESS
        port: 9091
