# Copy to lab/compose/screen-standalone.env and fill the image pin there.
# That file is gitignored. Do not commit a digest, an SSH target, or a key.
#
# Addresses below are RFC 5737 documentation values for the internal
# b0-screen network. They are not a lab subnet. ANDROID_UE_SCREEN_BIND is
# checked against docker inspect after the emulator is attached. A mismatch
# stops the script.
#
# ANDROID_UE_SCREEN_IMAGE must be name@sha256 and 64 hex digits.

ANDROID_EMULATOR_CONTAINER=b0-agen-emu
ANDROID_UE_SCREEN_IMAGE=REPLACE_ANDROID_UE_SCREEN_IMAGE
B0_SCREEN_SUBNET=192.0.2.0/24
B0_SCREEN_GATEWAY=192.0.2.1
ANDROID_UE_SCREEN_BIND=192.0.2.32
SCREEN_PUBLISH_ADDR=192.0.2.33
ANDROID_UE_SCREEN_PORT=8000
ANDROID_UE_SCREEN_PATH=/emulator/ue1
ANDROID_UE_SCREEN_MAX_SIZE=800
ANDROID_UE_SCREEN_BIT_RATE=2000000
ANDROID_UE_SCREEN_MAX_FPS=15
SCREEN_HOST_PORT=3301

# Guest tunnel. Not read by compose. The target stays out of git.
# ANDROID_EMULATOR_SSH_TARGET=REPLACE_ANDROID_EMULATOR_SSH_TARGET
# SCREEN_TUNNEL_LOCAL_PORT=3302
# SCREEN_TUNNEL_REMOTE_PORT=3301

# The screen container does not mount kvm and does not set a group id.
# Detect the emulator host group on that machine and do not commit the number.
