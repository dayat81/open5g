# Copy to lab/compose/screen-standalone.env and fill the placeholders there.
# That file is gitignored. Do not commit an image id, a network name from
# the host, an SSH target, or a key.
#
# ANDROID_EMULATOR_CONTAINER is the emulator container name. adb listens on
# 127.0.0.1:5555 inside that netns. This compose does not publish that port.
# ANDROID_EMULATOR_NETWORK is the user-defined bridge that container already
# uses. Read the name on the host; do not invent one in git.
# ANDROID_UE_SCREEN_IMAGE is the loaded ws-scrcpy image. Use a repo digest
# (name@sha256:...) or an image id (sha256:...). A tag is refused.

ANDROID_EMULATOR_CONTAINER=b0-agen-emu
ANDROID_EMULATOR_NETWORK=REPLACE_ANDROID_EMULATOR_NETWORK
ANDROID_UE_SCREEN_IMAGE=REPLACE_ANDROID_UE_SCREEN_IMAGE
ANDROID_UE_SCREEN_PORT=8000
ANDROID_UE_SCREEN_PATH=/emulator/b0
SCREEN_HOST_PORT=3301

# Guest tunnel. Not read by compose. The target stays out of git.
# ANDROID_EMULATOR_SSH_TARGET=REPLACE_ANDROID_EMULATOR_SSH_TARGET
# SCREEN_TUNNEL_LOCAL_PORT=3302
# SCREEN_TUNNEL_REMOTE_PORT=3301

# The screen container does not mount kvm and does not set a group id.
# Detect the emulator host group on that machine and do not commit the number.
