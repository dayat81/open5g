# Copy to lab/compose/screen-standalone.env and fill the placeholders there.
# That file is gitignored. Do not commit a digest, a bridge name, an address,
# an SSH target, or a key.
#
# ANDROID_EMULATOR_CONTAINER is the emulator that is already running.
# ANDROID_EMULATOR_NETWORK is its user-defined bridge. Read the name on the host.
# ANDROID_UE_SCREEN_BIND is that container's address on the bridge. The sidecar
# listens only there. Do not use loopback: Docker DNAT cannot reach it.
# ANDROID_UE_SCREEN_IMAGE must be name@sha256 and 64 hex digits. A tag is refused.

ANDROID_EMULATOR_CONTAINER=b0-agen-emu
ANDROID_EMULATOR_NETWORK=REPLACE_ANDROID_EMULATOR_NETWORK
ANDROID_UE_SCREEN_IMAGE=REPLACE_ANDROID_UE_SCREEN_IMAGE
ANDROID_UE_SCREEN_BIND=REPLACE_ANDROID_UE_SCREEN_BIND
ANDROID_UE_SCREEN_PORT=8000
ANDROID_UE_SCREEN_PATH=/emulator/ue1
ANDROID_UE_SCREEN_MAX_SIZE=800
ANDROID_UE_SCREEN_BIT_RATE=2000000
ANDROID_UE_SCREEN_MAX_FPS=15
SCREEN_HOST_PORT=3301

# Guest tunnel. Not read by compose. The target stays out of git.
# ANDROID_EMULATOR_SSH_TARGET=REPLACE_ANDROID_EMULATOR_SSH_TARGET
# SCREEN_TUNNEL_LOCAL_PORT=3302
# SCREEN_TUNNEL_REMOTE_PORT=3301

# The screen container does not mount kvm and does not set a group id.
# Detect the emulator host group on that machine and do not commit the number.
