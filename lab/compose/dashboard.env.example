# Copy to lab/compose/dashboard.env and replace every placeholder before `up`.
# dashboard.env is gitignored. Do not commit it.
# Names only in git. Values come from the operator vault.
# python -m open5g_dashboard rejects empty values and any value containing REPLACE_ or CHANGEME.

# Session cookie pepper. At least 32 characters. Unique per deployment.
OPEN5G_SESSION_PEPPER=REPLACE_WITH_32_CHARACTER_LOCAL_SECRET

# Dashboard Postgres, not the Open5GS MongoDB.
OPEN5G_DATABASE_URL=postgresql://open5g:REPLACE_WITH_LOCAL_PASSWORD@dashboard-postgres:5432/open5g
POSTGRES_USER=open5g
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=open5g

OPEN5G_COOKIE_SECURE=0
OPEN5G_ENABLE_DEMO_ROUTES=0

# Keep this 0. Stock Open5GS 2.8 has no working admin-RAR path.
OPEN5G_ENABLE_GX_RAR=0

# Subscriber store on the external network lab5g-dev_mgmt.
# The lab service name is mongo. Leave empty to disable writes.
# Example once approved: mongodb://mongo:27017/open5gs
OPEN5G_MONGO_URI=
OPEN5G_MONGO_DATABASE=open5gs
OPEN5G_MONGO_COLLECTION=subscribers
OPEN5G_MONGO_TIMEOUT_MS=2000

# name=url pairs. Empty means NF status is not_configured, not a scrape error.
OPEN5G_METRICS_ENDPOINTS=
OPEN5G_HEALTH_ENDPOINTS=
OPEN5G_METRICS_TIMEOUT_S=2

# Comma-separated APNs the SMF may serve. Empty does not enforce a list.
OPEN5G_APN_ALLOWLIST=

# Comma-separated browser origins. Empty disables CORS. A wildcard is rejected.
OPEN5G_CORS_ORIGINS=

# API listen address inside the container. Do not publish this port.
OPEN5G_BIND_HOST=0.0.0.0
OPEN5G_BIND_PORT=8000

# Compose interpolation, not container env. Export them or put them in lab/compose/.env.
# WEB_PORT defaults to 3300. Port 3000 is Grafana in this lab, so the dashboard does not use it.
# DASHBOARD_WEB_BIND=127.0.0.1
# WEB_PORT=3300
# DASHBOARD_API_IMAGE=open5g-dashboard-api:local
# DASHBOARD_WEB_IMAGE=open5g-dashboard-web:local
# DASHBOARD_POSTGRES_IMAGE=postgres:16
# OPEN5G_API_INTERNAL_URL=http://dashboard-api:8000
