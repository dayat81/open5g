# Copy to lab/compose/android-ue.env and fill the REPLACE_ values there.
# That file is gitignored. This example is the sanitized plan already published
# in infra/group_vars/all/lab.yml and lab/compose/docker-compose.yml, plus free
# host addresses that do not use the stock eNB/UE pair (.20/.21) or eNB ID 0x19B.
# Do not put real IMSI, IMEI, Ki, or OPc in this example.

ANDROID_UE_SRS_IMAGE=gradiant/srsran-4g:25_10
ANDROID_UE_ANDROID_IMAGE=open5g-android-emulator:local
# ws-scrcpy sidecar. Placeholder until the guest mirror has the image.
ANDROID_UE_SCREEN_IMAGE=REPLACE_ANDROID_UE_SCREEN_IMAGE
ANDROID_UE_SCREEN_PORT=8000
# Starting scrcpy limits. The sidecar writes these into the page. Override in the gitignored env.
ANDROID_UE_SCREEN_MAX_SIZE=800
ANDROID_UE_SCREEN_BIT_RATE=2000000
ANDROID_UE_SCREEN_MAX_FPS=15
# Standalone host. Placeholders only. android-ue-magen.sh refuses a value that is not name@sha256.
O5G_SCREEN_SUBNET=REPLACE_O5G_SCREEN_SUBNET
O5G_SCREEN_GATEWAY=REPLACE_O5G_SCREEN_GATEWAY
O5G_SCREEN_EMULATOR_ADDR=REPLACE_O5G_SCREEN_EMULATOR_ADDR
O5G_SCREEN_LISTENER_ADDR=REPLACE_O5G_SCREEN_LISTENER_ADDR
O5G_SCREEN_LISTENER_IMAGE=REPLACE_O5G_SCREEN_LISTENER_IMAGE
O5G_DASHBOARD_NETWORK=REPLACE_O5G_DASHBOARD_NETWORK
# Documentation range (RFC 5737), not a lab subnet. The screen sidecar binds here, not on uu.
ANDROID_UE_SCREEN_SUBNET=192.0.2.0/24
ANDROID_UE_SCREEN_GATEWAY=192.0.2.1
# Host source on l5gd-screen. The dashboard API container is not attached to this network.
ANDROID_UE_SCREEN_ALLOW_FROM=192.0.2.1
ANDROID_UE_CGNAT_IMAGE=REPLACE_ANDROID_UE_CGNAT_IMAGE
ANDROID_UE_TUN2SOCKS_IMAGE=REPLACE_ANDROID_UE_TUN2SOCKS_IMAGE
ANDROID_UE_DNS_IMAGE=REPLACE_ANDROID_UE_DNS_IMAGE
# GW_IP:1080. Not a real address. The guest sshd listens here for the reverse tunnel.
ANDROID_UE_SOCKS_ADDR=REPLACE_ANDROID_UE_SOCKS_ADDR
ANDROID_UE_LAB_SUBNET=REPLACE_ANDROID_UE_LAB_SUBNET

ANDROID_UE_S1MME_NETWORK=lab5g-dev_s1mme
ANDROID_UE_S1U_NETWORK=lab5g-dev_s1u
ANDROID_UE_UU_NETWORK=lab5g-dev_uu
ANDROID_UE_SGI_NETWORK=lab5g-dev_sgi
ANDROID_UE_EGRESS_NETWORK=REPLACE_ANDROID_UE_EGRESS_NETWORK

MCC=001
MNC=01
TAC=0x0001
N_PRB=50
TX_GAIN=80
RX_GAIN=40
MME_ADDR=10.99.1.10
APN=internet
UE_ALGO=milenage
DL_EARFCN=3350
ZMQ_BASE_SRATE=23.04e6
ANDROID_UE_ZMQ_WAIT=60
ANDROID_UE_ATTACH_TIMEOUT=180

ANDROID_UE_MEMORY=2048
# Container limit for the emulator. api-33 with QEMU and swiftshader needs this above ANDROID_UE_MEMORY.
ANDROID_UE_MEM_LIMIT=4096m
ANDROID_UE_CORES=2
ANDROID_UE_SKIP_AUTH=true
ANDROID_UE_DISABLE_ANIMATION=true
# The api-33 emulator rejects -partition-size=2048. The size is a separate argument.
ANDROID_UE_EXTRA_FLAGS=-no-metrics -no-audio -partition-size 2048
# Seconds to wait for sys.boot_completed. The image watcher uses the same value.
ANDROID_UE_BOOT_TIMEOUT=600
# 0 skips the boot wait. Leave this at 1 except for a netns-only window.
ANDROID_UE_BOOT_GATE=1
# Example locally chosen ULA inside fc00::/7. Not a documentation prefix and not a lab allocation.
# Replace it in the gitignored env with another /128 from that range if the lab wants a different one.
ANDROID_UE_IPV6_ULA=fdc2:fd97:24a4::1/128
# Numeric GID of the host group that can open /dev/kvm. Not a lab-specific number.
ANDROID_UE_KVM_GID=REPLACE_ANDROID_UE_KVM_GID
# DNS the SMF/PGW gives the UE. Not Docker's 127.0.0.11 resolver.
ANDROID_UE_PGW_DNS=REPLACE_ANDROID_UE_PGW_DNS
ANDROID_UE_DNS_UPSTREAM=1.1.1.1

# For the SOCKS window set this to <UE1_ADDR>/32. The wide lab pool must not be the steered prefix.
UE_POOL=10.45.0.0/16
UPF_SGI_ADDR=10.99.9.10
CGNAT_SGI_ADDR=10.99.9.30
# Address of cgnat on the internal egress network. This is the SOCKS source, not the SGi address.
CGNAT_EGRESS_ADDR=REPLACE_CGNAT_EGRESS_ADDR
# Account the laptop uses for ssh -R. Public key only. OpenSSH on the guest must be 7.8 or newer.
ANDROID_UE_TUNNEL_USER=REPLACE_ANDROID_UE_TUNNEL_USER
ANDROID_UE_TUNNEL_PUBKEY=REPLACE_ANDROID_UE_TUNNEL_PUBKEY
# Unused on the SOCKS path. Internet leaves through tun2socks, not this address.
CGNAT_SNAT_ADDR=100.64.0.1
CGNAT_CT_LIMIT=200
SGI_SERVER=10.99.9.20
ANDROID_UE_UPF_CONTAINER=l5gd-upf
# Host route installed on the android eNB, the same one lab-routes installs on the stock eNB.
ANDROID_UE_SGWU_GTPU_ROUTE=REPLACE_ANDROID_UE_SGWU_GTPU_ROUTE
# SGi address used for the ping that runs before the emulator and before --install-upf-route.
ANDROID_UE_SGI_PROBE=REPLACE_ANDROID_UE_SGI_PROBE
ANDROID_UE_MME_CONTAINER=l5gd-mme
ANDROID_UE_INSTALL_UPF_ROUTE=0
ANDROID_UE_ALLOW_SECOND=0

UE1_ENB_ID=0x1A1
UE1_ENB_S1=10.99.1.31
UE1_ENB_S1U=10.99.2.31
UE1_ENB_UU=10.99.11.31
UE1_UU=10.99.11.32
UE1_SCREEN_ADDR=192.0.2.32
UE1_PORT_BLOCK=15000-19999
UE1_ADDR=REPLACE_UE1_ADDR
UE1_IMSI=REPLACE_UE1_IMSI
UE1_KI=REPLACE_UE1_KI
UE1_OPC=REPLACE_UE1_OPC
UE1_IMEI=REPLACE_UE1_IMEI

UE2_ENB_ID=0x1A2
UE2_ENB_S1=10.99.1.33
UE2_ENB_S1U=10.99.2.33
UE2_ENB_UU=10.99.11.33
UE2_UU=10.99.11.34
UE2_SCREEN_ADDR=192.0.2.34
UE2_PORT_BLOCK=20000-24999
UE2_ADDR=REPLACE_UE2_ADDR
UE2_IMSI=REPLACE_UE2_IMSI
UE2_KI=REPLACE_UE2_KI
UE2_OPC=REPLACE_UE2_OPC
UE2_IMEI=REPLACE_UE2_IMEI
