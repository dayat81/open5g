# Copy to lab/compose/android-ue.env and fill the REPLACE_ values there.
# That file is gitignored. This example is the sanitized plan already published
# in infra/group_vars/all/lab.yml and lab/compose/docker-compose.yml, plus free
# host addresses that do not use the stock eNB/UE pair (.20/.21) or eNB ID 0x19B.
# Do not put real IMSI, IMEI, Ki, or OPc in this example.

ANDROID_UE_SRS_IMAGE=gradiant/srsran-4g:25_10
ANDROID_UE_ANDROID_IMAGE=halimqarroum/docker-android:api-33
ANDROID_UE_CGNAT_IMAGE=REPLACE_ANDROID_UE_CGNAT_IMAGE
ANDROID_UE_TUN2SOCKS_IMAGE=REPLACE_ANDROID_UE_TUN2SOCKS_IMAGE
ANDROID_UE_DNS_IMAGE=REPLACE_ANDROID_UE_DNS_IMAGE
# GW_IP:1080. Not a real address. The guest sshd listens here for the reverse tunnel.
ANDROID_UE_SOCKS_ADDR=REPLACE_ANDROID_UE_SOCKS_ADDR
ANDROID_UE_LAB_SUBNET=REPLACE_ANDROID_UE_LAB_SUBNET

ANDROID_UE_S1MME_NETWORK=lab5g-dev_s1mme
ANDROID_UE_S1U_NETWORK=lab5g-dev_s1u
ANDROID_UE_UU_NETWORK=lab5g-dev_uu
ANDROID_UE_SGI_NETWORK=lab5g-dev_sgi
ANDROID_UE_EGRESS_NETWORK=REPLACE_ANDROID_UE_EGRESS_NETWORK

MCC=001
MNC=01
TAC=0x0001
N_PRB=50
TX_GAIN=80
RX_GAIN=40
MME_ADDR=10.99.1.10
APN=internet
UE_ALGO=milenage
DL_EARFCN=3350
ZMQ_BASE_SRATE=23.04e6
ANDROID_UE_ZMQ_WAIT=60
ANDROID_UE_ATTACH_TIMEOUT=180

ANDROID_UE_MEMORY=2048
ANDROID_UE_CORES=2
ANDROID_UE_SKIP_AUTH=true
ANDROID_UE_DISABLE_ANIMATION=true
ANDROID_UE_EXTRA_FLAGS=-no-metrics -no-audio -partition-size=2048

UE_POOL=10.45.0.0/16
UPF_SGI_ADDR=10.99.9.10
CGNAT_SGI_ADDR=10.99.9.30
# Unused on the SOCKS path. Internet leaves through tun2socks, not this address.
CGNAT_SNAT_ADDR=100.64.0.1
CGNAT_CT_LIMIT=200
SGI_SERVER=10.99.9.20
ANDROID_UE_UPF_CONTAINER=l5gd-upf
ANDROID_UE_MME_CONTAINER=l5gd-mme
ANDROID_UE_INSTALL_UPF_ROUTE=0
ANDROID_UE_ALLOW_SECOND=0

UE1_ENB_ID=0x1A1
UE1_ENB_S1=10.99.1.31
UE1_ENB_S1U=10.99.2.31
UE1_ENB_UU=10.99.11.31
UE1_UU=10.99.11.32
UE1_ADB_HOST_PORT=15551
UE1_PORT_BLOCK=15000-19999
UE1_IMSI=REPLACE_UE1_IMSI
UE1_KI=REPLACE_UE1_KI
UE1_OPC=REPLACE_UE1_OPC
UE1_IMEI=REPLACE_UE1_IMEI

UE2_ENB_ID=0x1A2
UE2_ENB_S1=10.99.1.33
UE2_ENB_S1U=10.99.2.33
UE2_ENB_UU=10.99.11.33
UE2_UU=10.99.11.34
UE2_ADB_HOST_PORT=15552
UE2_PORT_BLOCK=20000-24999
UE2_IMSI=REPLACE_UE2_IMSI
UE2_KI=REPLACE_UE2_KI
UE2_OPC=REPLACE_UE2_OPC
UE2_IMEI=REPLACE_UE2_IMEI
