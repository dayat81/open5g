# Copy to .env; never commit. Example deliberately non-secret placeholders.
LAB_UE_KI=REPLACE_VIA_ANSIBLE_VAULT
LAB_UE_OPC=REPLACE_VIA_ANSIBLE_VAULT
# Dashboard Phase 1 names. Empty URI disables subscriber writes.
OPEN5G_MONGO_URI=
OPEN5G_MONGO_DATABASE=open5gs
OPEN5G_MONGO_COLLECTION=subscribers
OPEN5G_MONGO_TIMEOUT_MS=2000
OPEN5G_ENABLE_GX_RAR=0
OPEN5G_METRICS_ENDPOINTS=
OPEN5G_HEALTH_ENDPOINTS=
OPEN5G_METRICS_TIMEOUT_S=2
